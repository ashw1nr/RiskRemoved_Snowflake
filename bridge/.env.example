# ===========================================================================
# Slack Bot for Risk Copilot "Ask the Data"
# Copy this file to .env and fill in your values.
# .env is gitignored -- never commit real tokens.
# ===========================================================================

# --- Slack Tokens (from api.slack.com/apps > Your App) -------------------
# Bot User OAuth Token (OAuth & Permissions page, starts with xoxb-)
SLACK_BOT_TOKEN=xoxb-REPLACE-ME

# App-Level Token (Basic Information > App-Level Tokens, starts with xapp-)
SLACK_APP_TOKEN=xapp-REPLACE-ME

# Signing Secret (Basic Information > App Credentials)
SLACK_SIGNING_SECRET=REPLACE-ME

# --- Snowflake Connection ------------------------------------------------
# Account identifier (e.g. hqrwrxk-uz26728)
SNOWFLAKE_ACCOUNT=hqrwrxk-uz26728

# User that the bot authenticates as
SNOWFLAKE_USER=RAGHAV2310

# Role the bot uses (must have access to RISK_COPILOT_DEV). Dev objects carry
# the _DEV suffix -- check with SHOW WAREHOUSES / CURRENT_AVAILABLE_ROLES().
SNOWFLAKE_ROLE=RC_SERVICE_ROLE_DEV

# Warehouse for running Analyst SQL. A wrong name fails as
# "002043 Object does not exist" after Analyst has already generated the SQL.
SNOWFLAKE_WAREHOUSE=RC_DEV_WH_DEV

# Path to the RSA private key file (for key-pair auth). Relative paths are
# resolved from bridge/, so start the bot from inside bridge/.
# SNOWFLAKE_PRIVATE_KEY_PATH=keys/<your_key>.p8

# Password (alternative to key-pair, for development only)
# SNOWFLAKE_PASSWORD=

# --- Cortex Analyst -------------------------------------------------------
# Fully qualified semantic view name
SNOWFLAKE_SEMANTIC_VIEW=RISK_COPILOT_DEV.CURATED.SV_RISK_COPILOT_DEV

# --- Mode -----------------------------------------------------------------
# Set to "true" to use canned demo responses instead of calling Snowflake.
# Use this when Snowflake credentials are not available.
DEMO_MODE=true

# --- Data account object names (the account above) ----------------------
DATA_DATABASE=RISK_COPILOT_DEV
DATA_OBJECT_SUFFIX=_DEV

# --- Agent account: Cortex Agent RC_STR_AGENT ----------------------------
# A separate Snowflake account hosts the STR agent (agent_account/). The bridge
# logs in as a key-pair SERVICE user; the private key never leaves this folder.
AGENT_SNOWFLAKE_ACCOUNT=HQRWRXK-UZ26728
AGENT_SNOWFLAKE_USER=RC_AGENT_SVC
AGENT_SNOWFLAKE_ROLE=RC_AGENT_ROLE
AGENT_SNOWFLAKE_WAREHOUSE=RC_AGENT_WH
AGENT_PRIVATE_KEY_PATH=keys/rc_agent_svc.p8
AGENT_DATABASE=RISK_COPILOT_AGENT
AGENT_SCHEMA=STR
AGENT_NAME=RC_STR_AGENT

# --- Reporting entity printed on the STR PDF ------------------------------
REPORTING_BANK_NAME=Demo Bank Ltd.
PRINCIPAL_OFFICER_NAME=Rajesh Menon
